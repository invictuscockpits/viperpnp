{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViperPNP",
  "version": "0.1.0",
  "identifier": "com.invictuscockpits.viperpnp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../dist-loader"
  },
  "app": {
    "windows": [
      {
        "title": "ViperPNP",
        "width": 1400,
        "height": 900,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
